{
  "version": 1,
  "about": "Fitted coefficients for LookPipeline's stages. Read by the app (bundle), lumina-render and Tools/parity/lookmath.py. Tools/parity/loop.sh edits `coefficients` and sets `locked` when a stage meets the parity criteria; a human edits everything else. The criteria live in Tools/parity/criteria.json and are never changed by the loop.",
  "workingSpace": "extendedLinearSRGB",
  "perceptualGamma": 2.2,
  "luma": [0.2126, 0.7152, 0.0722],
  "order": ["rawDevelop", "camera", "exposure", "whiteBalance", "whitesBlacks", "tone", "contrast", "dehaze", "curve", "colour", "mixer", "clarity", "sharpen", "vignette", "outputTransform"],
  "stages": {
    "rawDevelop": {
      "locked": false,
      "form": "CIRAWFilter with boostAmount 0 (Apple's linear decode, none of its look), no auto; scaleFactor for size; draft mode below draftBelowPx; lensShading undoes the lens's corner falloff in linear space with the camera's own VignettingCorrParams, scaled in stops (LookLensShading: 1 is the camera's partial correction; Lightroom's lens profile is 1.3-2.2x that on the sweep); then the `profile` stage (below) makes it Lightroom's Adobe Color. The base match (LookMath.baseMatch, baseLift … baseLoDesat) is what ran before the profile stage existed and runs only when `stages.profile` is absent; its numbers are 0 here",
      "coefficients": {
        "boostAmount": 0.0,
        "draftBelowPx": 0,
        "lensShading": 1.6,
        "baseRG": 0.0,
        "baseRB": 0.0,
        "baseGR": 0.0,
        "baseGB": 0.0,
        "baseBR": 0.0,
        "baseBG": 0.0,
        "baseLift": 0.0,
        "baseS": 0.0,
        "baseHiDesat": 0.0,
        "baseHiFrom": 0.9,
        "baseLoDesat": 0.0,
        "baseLoBelow": 0.2
      }
    },
    "camera": {
      "locked": false,
      "form": "the camera profile (look key prof:camera): the camera's own look for the Creative Style the photo was shot with (Sony MakerNote 0xB020, LookCameraStyle), on top of the base. The base match's form (LookMath.baseMatch) with the style's numbers, named <style>Lift, <style>S, <style>RG … <style>LoDesat; a style without numbers uses standard's. Fitted from Lumina's base to each ARW's embedded JPEG (Tools/parity/camera_fit.py), measured on held-out shoots",
      "coefficients": {
