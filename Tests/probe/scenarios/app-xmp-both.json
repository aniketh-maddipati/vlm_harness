   "path": "${DISKS}/LTCASE/shoot",
   "timeoutMs": 60000
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(), p=l.real[0]; return [l.real.length, p.xpath, !!p.lrEd, /xmp:Rating=/.test(p.xmp||''), /xmp:Label=/.test(p.xmp||'')]",
   "equals": [
    1,
    "shoot/DSC08186.xmp",
    true,
    false,
    false
   ],
   "why": "the lower-case .xmp (Lightroom's, unrated) is the sidecar; the 1★ Yellow .XMP is not read"
  },
  {
