{
 "mode": "app",
 "page": "Lumina Sets v8.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "stopOnFailure": true,
 "checklist": "F7 read-only / locked card (v5): the card reads fine; Save on a card is replaced by 'copy to disk first' with the page's notice, ⌘↩ writes nothing to the card (no .xmp, no temp files). First grant (R1c): the card is culled once through 'Cull this card' (sandboxed: the panel's pick, scripted), then a relaunch and the card out and in, so from here on it is a card the app already knows (sandboxed: through its bookmark), in both modes; the steps after that are unchanged.",
 "steps": [
  {
   "do": "startCards"
  },
  {
   "do": "diskImage",
   "name": "LTLOCKED",
   "sizeMB": 64,
   "from": "${LUMINA_FIXTURE_ROOT}/src",
   "trimBytes": 1400000,
   "count": 12,
   "readonly": true
  },
  {
   "do": "waitFor",
   "js": "return !!(window.lumina.card || window.lumina.cardPending)",
   "timeoutMs": 15000,
   "what": "card noticed (first insert)"
  },
  {
   "do": "sources",
   "paths": [
    "${DISKS}/LTLOCKED/DCIM"
   ],
   "why": "first grant: the answer to the card panel 'Cull this card' opens in the App Sandbox (unsandboxed no panel opens and this is unused)"
  },
  {
   "do": "js",
   "src": "__probe.logic().impStart(); return true"
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad && l.state.realInfo)",
   "timeoutMs": 60000,
   "what": "card read (first grant)"
  },
  {
   "do": "reload",
   "settleMs": 800
  },
  {
   "do": "detach",
   "name": "LTLOCKED"
  },
  {
   "do": "waitFor",
   "js": "return window.lumina.card===null && window.lumina.cardPending===null",
   "timeoutMs": 10000,
   "what": "card out after the first grant"
  },
  {
   "do": "attach",
   "name": "LTLOCKED",
   "readonly": true
  },
  {
   "do": "waitFor",
   "js": "return !!window.lumina.card",
   "timeoutMs": 15000,
   "what": "locked card noticed"
  },
  {
   "do": "key",
   "k": "0",
   "settleMs": 300
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 100
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad)",
   "timeoutMs": 60000,
   "what": "locked card read"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.realInfo.n",
   "equals": 12
  },
  {
   "do": "key",
   "k": "p",
   "settleMs": 200
  },
  {
   "do": "expect",
   "js": "return __probe.logic().kept().length",
   "equals": 1
  },
  {
   "do": "key",
   "k": "3",
   "cmd": true,
   "settleMs": 1000
  },
  {
   "do": "expect",
   "js": "return document.body.innerText.includes(\"Sidecars can't be written to a card\")",
   "why": "on a card the page offers 'copy to disk first' instead of Save"
  },
  {
   "do": "key",
   "k": "Enter",
   "cmd": true,
   "settleMs": 1500
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTLOCKED/DCIM",
   "glob": "*.xmp",
   "count": 0
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTLOCKED/DCIM",
   "glob": "*.lumina-tmp*",
   "count": 0
  },
  {
   "do": "invariants"
  }
 ]
}
