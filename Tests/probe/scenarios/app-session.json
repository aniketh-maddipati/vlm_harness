{
 "mode": "app",
 "page": "Lumina Sets v7.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "stopOnFailure": false,
 "checklist": "SAFETY.md 2 (v5): keeps (P), a removed photo (X), seen rows and the cursor are saved by the 2 s autosave, keyed by file path; after a relaunch the Open screen lists the shoot, ⏎ reopens it with every decision and the cursor's row; unsaved keepers are still counted (Quit asks). After ⌘↩ and another relaunch the keepers count as saved, and the sidecars are untouched by the reopen.",
 "steps": [
  {
   "do": "copyTree",
   "from": "${LUMINA_FIXTURE_ROOT}/src",
   "to": "${OUT}/shoot/src"
  },
  {
   "do": "openFolder",
   "path": "${OUT}/shoot/src",
   "timeoutMs": 120000
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return [l.state.realInfo.n, l.data.R.length, !!window.__lumina.shootId()]",
   "equals": [
    12,
    4,
    true
   ]
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "js",
   "src": "const a=document.activeElement; if (a && a.tagName==='INPUT') a.blur(); return true",
   "why": "v7: a shoot read for the first time puts the keyboard in its name field after 350 ms"
  },
  {
   "do": "key",
   "k": "p",
   "settleMs": 200
  },
  {
   "do": "key",
   "k": "ArrowRight",
   "settleMs": 200
  },
  {
   "do": "js",
   "src": "__probe.logic().setPref({adv:false}); return true",
   "why": "v5's flag left the cursor in place; v7's remove advances"
  },
  {
   "do": "key",
   "k": "x",
   "settleMs": 200
  },
  {
   "do": "js",
   "src": "__probe.logic().setPref({adv:true}); return true",
   "why": "auto-advance back on"
  },
  {
   "do": "key",
   "k": "ArrowDown",
   "settleMs": 200
  },
  {
   "do": "key",
   "k": "p",
   "settleMs": 200
  },
  {
   "do": "key",
   "k": "ArrowDown",
   "settleMs": 200
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.kept().map(id=>l.data.byId[id].file).sort()",
   "equals": [
    "DSC00001.ARW",
    "DSC00008.ARW"
   ]
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return Object.keys(l.state.marks).filter(id=>l.state.marks[id]==='out').map(id=>l.data.byId[id].file).sort()",
   "equals": [
    "DSC00002.ARW"
   ]
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.data.R.filter(r=>(l.state.seen||{})[r.id]).map(r=>l.data.byId[r.ids[0]].file)",
   "equals": [
    "DSC00001.ARW",
    "DSC00007.ARW"
   ],
   "why": "rows 1 and 2 were left, so they are seen"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.data.byId[l.state.cur].file",
   "equals": "DSC00010.ARW",
   "why": "the cursor is back in the row it was in (row 3)"
  },
  {
   "do": "expect",
   "js": "return __lumina.unsaved()",
   "equals": 2
  },
  {
   "do": "wait",
   "ms": 2600,
   "why": "the 2 s autosave"
  },
  {
   "do": "fs",
   "path": "${OUT}/support/shoots",
   "glob": "session.json",
   "count": 1
  },
  {
   "do": "reload",
   "why": "a relaunch: the page starts over, the Mac's shoot store is what's left"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return [l.state.view, !!l.real, l.data.order.length]",
   "equals": [
    "import",
    false,
    0
   ]
  },
  {
   "do": "expect",
   "js": "return __probe.logic().recents().map(x=>[x.n, x.kp])",
   "equals": [
    [
     12,
     2
    ]
   ],
   "why": "the Open screen lists the shoot with its photo and keeper counts"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 300
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad && l.state.realInfo && l.kept().length === 2)",
   "timeoutMs": 60000,
   "what": "reopened with its decisions"
  },
  {
   "do": "wait",
   "ms": 800,
   "why": "the page lands on the cursor's row after the decisions are back"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.kept().map(id=>l.data.byId[id].file).sort()",
   "equals": [
    "DSC00001.ARW",
    "DSC00008.ARW"
   ]
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return Object.keys(l.state.marks).filter(id=>l.state.marks[id]==='out').map(id=>l.data.byId[id].file).sort()",
   "equals": [
    "DSC00002.ARW"
   ]
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.data.R.filter(r=>(l.state.seen||{})[r.id]).map(r=>l.data.byId[r.ids[0]].file)",
   "equals": [
    "DSC00001.ARW",
    "DSC00007.ARW"
   ],
   "why": "rows 1 and 2 were left, so they are seen"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.data.byId[l.state.cur].file",
   "equals": "DSC00010.ARW",
   "why": "the cursor is back in the row it was in (row 3)"
  },
  {
   "do": "expect",
   "js": "return __lumina.unsaved()",
   "equals": 2,
   "why": "never saved: Quit still asks about 2 keepers"
  },
  {
   "do": "snap",
   "name": "restored"
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "js",
   "src": "const a=document.activeElement; if (a && a.tagName==='INPUT') a.blur(); return true",
   "why": "v7: a shoot read for the first time puts the keyboard in its name field after 350 ms"
  },
  {
   "do": "key",
   "k": "4",
   "settleMs": 1000,
   "cmd": true
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.view",
   "equals": "export"
  },
  {
   "do": "js",
   "src": "window.__lastSave = __probe.logic().state.ex.result || null; return true"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 1500,
   "cmd": true
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.armed",
   "equals": "save",
   "why": "v7: with undecided photos the first ⌘⏎ only warns"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 1500,
   "cmd": true
  },
  {
   "do": "waitFor",
   "js": "const r = __probe.logic().state.ex.result; return !!r && r !== window.__lastSave",
   "what": "save result"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.ex.result.t",
   "equals": "2 saved"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/src",
   "glob": "*.xmp",
   "count": 2
  },
  {
   "do": "expect",
   "js": "return __lumina.unsaved()",
   "equals": 0
  },
  {
   "do": "wait",
   "ms": 800,
   "why": "the session is written right after a save"
  },
  {
   "do": "reload",
   "why": "a relaunch: the page starts over, the Mac's shoot store is what's left"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return [l.state.view, !!l.real, l.data.order.length]",
   "equals": [
    "import",
    false,
    0
   ]
  },
  {
   "do": "expect",
   "js": "return __probe.logic().recents().map(x=>[x.n, x.kp])",
   "equals": [
    [
     12,
     2
    ]
   ],
   "why": "the Open screen lists the shoot with its photo and keeper counts"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 300
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad && l.state.realInfo && l.kept().length === 2)",
   "timeoutMs": 60000,
   "what": "reopened with its decisions"
  },
  {
   "do": "wait",
   "ms": 800,
   "why": "the page lands on the cursor's row after the decisions are back"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.kept().map(id=>l.data.byId[id].file).sort()",
   "equals": [
    "DSC00001.ARW",
    "DSC00008.ARW"
   ]
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return Object.keys(l.state.marks).filter(id=>l.state.marks[id]==='out').map(id=>l.data.byId[id].file).sort()",
   "equals": [
    "DSC00002.ARW"
   ]
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.data.R.filter(r=>(l.state.seen||{})[r.id]).map(r=>l.data.byId[r.ids[0]].file)",
   "equals": [
    "DSC00001.ARW",
    "DSC00007.ARW"
   ],
   "why": "rows 1 and 2 were left, so they are seen"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.data.byId[l.state.cur].file",
   "equals": "DSC00010.ARW",
   "why": "the cursor is back in the row it was in (row 3)"
  },
  {
   "do": "expect",
   "js": "return __lumina.unsaved()",
   "equals": 0,
   "why": "the saved keeper list survives the relaunch"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/src",
   "glob": "*.xmp",
   "count": 2
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/src",
   "glob": "*.lumina-bak",
   "count": 0,
   "why": "reopening writes nothing into the shoot folder"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/src/DSC00008.xmp",
   "contains": "xmp:Rating=\"3\""
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/src/DSC00002.xmp",
   "exists": false,
   "why": "a removed photo is not saved"
  },
  {
   "do": "invariants"
  }
 ]
}
