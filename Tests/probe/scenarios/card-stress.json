  {
   "do": "wheel",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "dy": -120,
   "frames": 150,
   "name": "cull-scroll-up",
   "p95Ms": 17.5
  },
  {
   "do": "key",
   "k": "ArrowDown",
   "times": 150,
   "gapMs": 8,
   "settleMs": 500
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return l.data.byId[l.state.cur]!=null"
  },
  {
   "do": "fuzz",
   "seed": 11,
   "count": 3000,
   "gapMs": [
    0,
    15
   ],
   "checkEvery": 25,
   "mouseRate": 0.05
  },
  {
   "do": "key",
   "k": "Escape",
   "settleMs": 200
  },
  {
   "do": "key",
   "k": "Escape",
   "settleMs": 200
  },
  {
