{
 "mode": "app",
 "page": "Lumina Sets v5.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "sampleMs": 100,
 "stopOnFailure": false,
 "checklist": "Fast scrolling in Cull on a real shoot (1440 \u00d7 900): frame pacing, % of on-screen tiles not yet showing their thumbnail (sampled every frame), thumbnail upscale ratio (image px per device px; < 1 = magnified), mid-scroll snapshots, web-process memory. Folder: LUMINA_SCROLL_DIR (probe.sh scroll sets it). tile216-dy150-nowarm: the same pass with plumbing's warm-ahead decoding off (A/B)",
 "budgets": {
  "webPeakMB": 1500
 },
 "steps": [
  {
   "do": "openFolder",
   "path": "${LUMINA_SCROLL_DIR}",
   "via": "js",
   "timeoutMs": 900000
  },
  {
   "do": "js",
   "src": "const i=__probe.logic().state.realInfo; return JSON.stringify({n:i.n,rows:i.rows,stacks:i.stacks,secs:+i.secs})"
  },
  {
   "do": "dump",
   "name": "thumb",
   "js": "const r=__probe.logic().real.filter(p=>p.src).slice(0,40); return Promise.all(r.map(p=>fetch(p.src).then(x=>x.blob()).then(b=>new Promise(res=>{ const im=new Image(); im.onload=()=>res({kb:Math.round(b.size/1024),w:im.naturalWidth,h:im.naturalHeight}); im.onerror=()=>res(null); im.src=p.src; })))).then(a=>JSON.stringify(a.filter(Boolean)))"
  },
  {
   "do": "js",
   "src": "__probe.logic().setState({tsz:1}); return true"
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wheel",
   "name": "tile144-dy60",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "frames": 120,
   "dy": 60,
   "tiles": true
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wheel",
   "name": "tile144-dy150",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "frames": 120,
   "dy": 150,
   "tiles": true
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wheel",
   "name": "tile144-snaps",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "frames": 90,
   "dy": 150,
   "snapAt": [
    20,
    45,
    70
   ]
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 600
  },
  {
   "do": "js",
   "src": "__probe.logic().setState({tsz:2}); return true"
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wheel",
   "name": "tile216-dy60",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "frames": 120,
   "dy": 60,
   "tiles": true
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wheel",
   "name": "tile216-dy150",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "frames": 120,
   "dy": 150,
   "tiles": true
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "js",
   "src": "return __lumina.warmAhead(false)"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wheel",
   "name": "tile216-dy150-nowarm",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "frames": 120,
   "dy": 150,
   "tiles": true
  },
  {
   "do": "js",
   "src": "return __lumina.warmAhead(true)"
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "wheel",
   "name": "tile216-snaps",
   "sel": "[data-screen-label=\"1 Cull\"]",
   "frames": 90,
   "dy": 150,
   "snapAt": [
    20,
    45,
    70
   ]
  },
  {
   "do": "js",
   "src": "const el=document.querySelector('[data-screen-label=\"1 Cull\"]'); el.scrollTop=0; return true"
  },
  {
   "do": "wait",
   "ms": 600
  },
  {
   "do": "snap",
   "name": "rest"
  }
 ]
}