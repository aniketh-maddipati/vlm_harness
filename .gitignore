# Lumina
.DS_Store
.exiftool/
DerivedData/

# --- Artifact store (CQ.4) ---
# Capture output is regenerable and is never committed: --capture-workbench,
# --raw-harness and --develop-lab all rewrite it on demand. The only committed
# harness state is the approved golden store, the tokens hash, and the summary
# ledger; per-run ledgers and lane reports stay local.
artifacts/*
!artifacts/harness/
artifacts/harness/*
!artifacts/harness/goldens/
!artifacts/harness/tokens.hash
!artifacts/harness/ledgers/
artifacts/harness/ledgers/*
!artifacts/harness/ledgers/orchestration-only.json

# Never commit full-res ProPhoto TIFFs or private RAW originals, anywhere.
**/handoff/*.tif
**/handoff/*.tiff
**/handoff/*.ARW
**/handoff/*.arw

# --- Worktree roots (CQ.4) ---
# Checkpoint worktrees are siblings by convention, but never inside the repo.
lumina-wt/
*.worktree/

# Xcode
xcuserdata/
*.xcuserstate
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
.build/
Carthage/Build/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# UI-automation run outputs (xcresults, logs, isolated state)
artifacts/ui-automation/
*.profraw

Scripts/harness/**/__pycache__/
**/__pycache__/
