{
 "mode": "app",
 "page": "Lumina Sets v7.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "checklist": "The app reads a folder natively, keeps, saves sidecars into the folder (with .lumina-bak), and reopens with its decisions",
 "stopOnFailure": false,
 "steps": [
  {
   "do": "expect",
   "js": "return __probe.logic().state.view",
   "equals": "import"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().data.order.length",
   "equals": 0
  },
  {
   "do": "copyTree",
   "from": "${LUMINA_FIXTURE_ROOT}/two-bodies",
   "to": "${OUT}/shoot/two-bodies"
  },
  {
   "do": "writeFile",
   "path": "${OUT}/shoot/two-bodies/NOTES.txt",
   "text": "not a photo"
  },
  {
   "do": "openFolder",
   "path": "${OUT}/shoot/two-bodies",
   "timeoutMs": 120000
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "expect",
   "js": "const a=document.activeElement; return a ? a.tagName : 'none'",
   "equals": "INPUT",
   "why": "v7: a shoot opened for the first time puts the keyboard in its name field"
  },
  {
   "do": "js",
   "src": "document.activeElement && document.activeElement.blur(); return true"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.view",
   "equals": "cull"
  },
  {
   "do": "expect",
   "js": "return !!window.__lumina.shootId()"
  },
  {
   "do": "expect",
   "js": "return window.lumina.readingCard",
   "equals": false
  },
  {
   "do": "expect",
   "js": "const i = __lumina.inspect(); return [i.lgHeld, i.srcNotBlob, i.dupPaths, i.zsrcOff]",
   "equals": [
    0,
    0,
    0,
    0
   ]
  },
  {
   "do": "expect",
   "js": "return (__probe.logic().state.notes || []).length > 0"
  },
  {
   "do": "expect",
   "js": "const P = __probe.logic().real, d = await window.lumina.near(P[0].path, P[1].path); return [typeof d, d > 0 && d < 2, await window.lumina.near(P[0].path, P[0].path), await window.lumina.near(P[0].path, 'two-bodies/NOPE.ARW')]",
   "equals": [
    "number",
    true,
    0,
    null
   ],
   "what": "lumina.near: the Mac's distance between two photos' previews; 0 for a photo and itself; null for one that was not read"
  },
  {
   "do": "snap",
   "name": "cull"
  },
  {
   "do": "key",
   "k": "p",
   "settleMs": 200
  },
  {
   "do": "key",
   "k": "ArrowRight",
   "settleMs": 200
  },
  {
   "do": "key",
   "k": "p",
   "settleMs": 200
  },
  {
   "do": "expect",
   "js": "return __probe.logic().kept().length",
   "equals": 2
  },
  {
   "do": "expect",
   "js": "return __lumina.unsaved()",
   "equals": 2
  },
  {
   "do": "wait",
   "ms": 2300
  },
  {
   "do": "key",
   "k": "4",
   "cmd": true,
   "settleMs": 1000
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.view",
   "equals": "export"
  },
  {
   "do": "snap",
   "name": "save"
  },
  {
   "do": "key",
   "k": "Enter",
   "cmd": true,
   "settleMs": 1500
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.armed",
   "equals": "save",
   "why": "v7: with undecided photos the first ⌘⏎ only warns"
  },
  {
   "do": "key",
   "k": "Enter",
   "cmd": true,
   "settleMs": 1500
  },
  {
   "do": "waitFor",
   "js": "const r = __probe.logic().state.ex.result; return !!r",
   "what": "save result"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.ex.result.t",
   "equals": "2 saved"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.ex.result.where.endsWith('/shoot/two-bodies')"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/two-bodies",
   "count": 2,
   "glob": "*.xmp"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/two-bodies",
   "count": 0,
   "glob": "*.lumina-tmp-*"
  },
  {
   "do": "expect",
   "js": "return __lumina.unsaved()",
   "equals": 0
  },
  {
   "do": "snap",
   "name": "saved"
  },
  {
   "do": "js",
   "src": "__lumina.closeShoot()"
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.view",
   "equals": "import"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().recents().length",
   "equals": 1
  },
  {
   "do": "expect",
   "js": "return __probe.logic().recents()[0].kp",
   "equals": 2
  },
  {
   "do": "snap",
   "name": "open-recent"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 300
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad && l.kept().length === 2)",
   "timeoutMs": 60000,
   "what": "reopened with 2 keepers"
  },
  {
   "do": "expect",
   "js": "return __lumina.unsaved()",
   "equals": 0
  },
  {
   "do": "writeFile",
   "path": "${OUT}/shoot/two-bodies/A_DSC00001.xmp",
   "text": "<?xpacket begin=\"﻿\" id=\"W5M0MpCehiHzreSzNTczkc9d\"?>\n<x:xmpmeta xmlns:x=\"adobe:ns:meta/\">\n <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n  <rdf:Description rdf:about=\"\" xmlns:xmp=\"http://ns.adobe.com/xap/1.0/\" xmp:Rating=\"5\" xmp:Label=\"edited in Lightroom\"/>\n </rdf:RDF>\n</x:xmpmeta>\n<?xpacket end=\"w\"?>\n",
   "why": "Lightroom edits the sidecars between two Lumina saves"
  },
  {
   "do": "writeFile",
   "path": "${OUT}/shoot/two-bodies/B_DSC00001.xmp",
   "text": "<?xpacket begin=\"﻿\" id=\"W5M0MpCehiHzreSzNTczkc9d\"?>\n<x:xmpmeta xmlns:x=\"adobe:ns:meta/\">\n <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n  <rdf:Description rdf:about=\"\" xmlns:xmp=\"http://ns.adobe.com/xap/1.0/\" xmp:Rating=\"5\" xmp:Label=\"edited in Lightroom\"/>\n </rdf:RDF>\n</x:xmpmeta>\n<?xpacket end=\"w\"?>\n"
  },
  {
   "do": "js",
   "src": "window.__firstSave = __probe.logic().state.ex.result; return true"
  },
  {
   "do": "key",
   "k": "4",
   "cmd": true,
   "settleMs": 1000
  },
  {
   "do": "key",
   "k": "Enter",
   "cmd": true,
   "settleMs": 1500
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.armed",
   "equals": "save",
   "why": "v7: with undecided photos the first ⌘⏎ only warns"
  },
  {
   "do": "key",
   "k": "Enter",
   "cmd": true,
   "settleMs": 1500
  },
  {
   "do": "waitFor",
   "js": "const r = __probe.logic().state.ex.result; return !!r && r !== window.__firstSave",
   "what": "second save"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/two-bodies",
   "count": 2,
   "glob": "*.xmp.lumina-bak"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/two-bodies/A_DSC00001.xmp.lumina-bak",
   "contains": "edited in Lightroom",
   "why": "the backup is Lightroom's version, not Lumina's first save"
  },
  {
   "do": "fs",
   "path": "${OUT}/shoot/two-bodies/A_DSC00001.xmp",
   "contains": "xmp:Rating=\"3\""
  },
  {
   "do": "invariants"
  }
 ]
}
