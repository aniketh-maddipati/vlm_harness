{
 "mode": "app",
 "page": "Lumina Sets v5.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "stopOnFailure": false,
 "checklist": "F6 'both': on a case-sensitive volume a RAW has DSC.xmp (Lightroom's) and DSC.XMP (1★ Yellow). The lower-case .xmp is read, every time; in a folder holding both (a second case-sensitive disk: the source's disk is removable, so it counts as the card and is refused), only .xmp is merged (stars change, the rest byte-identical) and kept as .lumina-bak; .XMP is never touched, in the destination or the source",
 "steps": [
  {
   "do": "diskImage",
   "name": "LTCASE",
   "sizeMB": 200,
   "fs": "Case-sensitive APFS"
  },
  {
   "do": "copyTree",
   "from": "${LUMINA_FIXTURE_ROOT}/lr-sidecar-both",
   "to": "${DISKS}/LTCASE/shoot"
  },
  {
   "do": "move",
   "from": "${DISKS}/LTCASE/shoot/DSC08186.upper.XMP",
   "to": "${DISKS}/LTCASE/shoot/DSC08186.XMP"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASE/shoot",
   "glob": "DSC08186.*",
   "count": 3
  },
  {
   "do": "openFolder",
   "path": "${DISKS}/LTCASE/shoot",
   "timeoutMs": 60000
  },
  {
   "do": "expect",
   "js": "const p=__probe.logic().real[0]; return [p.xpath, /xmp:Rating=/.test(p.xmp||'')]",
   "equals": [
    "shoot/DSC08186.xmp",
    false
   ]
  },
  {
   "do": "openFolder",
   "path": "${DISKS}/LTCASE/shoot",
   "timeoutMs": 60000
  },
  {
   "do": "expect",
   "js": "const p=__probe.logic().real[0]; return [p.xpath, /xmp:Rating=/.test(p.xmp||'')]",
   "equals": [
    "shoot/DSC08186.xmp",
    false
   ]
  },
  {
   "do": "openFolder",
   "path": "${DISKS}/LTCASE/shoot",
   "timeoutMs": 60000
  },
  {
   "do": "expect",
   "js": "const p=__probe.logic().real[0]; return [p.xpath, /xmp:Rating=/.test(p.xmp||'')]",
   "equals": [
    "shoot/DSC08186.xmp",
    false
   ]
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.realInfo.xmpN",
   "equals": 1
  },
  {
   "do": "key",
   "k": "1",
   "settleMs": 300
  },
  {
   "do": "key",
   "k": "ArrowRight",
   "settleMs": 150
  },
  {
   "do": "key",
   "k": "ArrowRight",
   "settleMs": 150
  },
  {
   "do": "key",
   "k": "r",
   "settleMs": 150
  },
  {
   "do": "expect",
   "js": "return Object.values(__probe.logic().state.marks).filter(m=>m==='keep').length",
   "equals": 1
  },
  {
   "do": "diskImage",
   "name": "LTCASED",
   "sizeMB": 100,
   "fs": "Case-sensitive APFS"
  },
  {
   "do": "copyTree",
   "from": "${LUMINA_FIXTURE_ROOT}/lr-sidecar-both",
   "to": "${DISKS}/LTCASED/lr-folder"
  },
  {
   "do": "move",
   "from": "${DISKS}/LTCASED/lr-folder/DSC08186.upper.XMP",
   "to": "${DISKS}/LTCASED/lr-folder/DSC08186.XMP"
  },
  {
   "do": "remove",
   "path": "${DISKS}/LTCASED/lr-folder/DSC08186.ARW"
  },
  {
   "do": "key",
   "k": "3",
   "settleMs": 500
  },
  {
   "do": "destinations",
   "paths": [
    "${DISKS}/LTCASED/lr-folder"
   ]
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 2500
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASED/lr-folder",
   "glob": "DSC08186.*",
   "count": 3
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASED/lr-folder/DSC08186.xmp.lumina-bak",
   "same": "${LUMINA_FIXTURE_ROOT}/lr-sidecar-both/DSC08186.xmp"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASED/lr-folder/DSC08186.XMP",
   "same": "${LUMINA_FIXTURE_ROOT}/lr-sidecar-both/DSC08186.upper.XMP"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASED/lr-folder/DSC08186.XMP.lumina-bak",
   "exists": false
  },
  {
   "do": "xmpMerged",
   "dir": "${DISKS}/LTCASED/lr-folder",
   "originals": "${LUMINA_FIXTURE_ROOT}/lr-sidecar-both",
   "expectJs": "const l=__probe.logic(), s=l.state, ex=s.ex||{}, o={}; for (const id of l.data.order) { const p=l.data.byId[id], fin=!!s.final[id]; if (s.marks[id]!=='keep' && !fin) continue; o[(p.xpath||'').split('/').pop()]={rating:String(fin?(ex.rf||5):(ex.rk||3)), label: fin && (ex.lab||'Green')!=='None' ? (ex.lab||'Green') : null}; } return o;"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASE/shoot/DSC08186.xmp",
   "same": "${LUMINA_FIXTURE_ROOT}/lr-sidecar-both/DSC08186.xmp"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASE/shoot/DSC08186.XMP",
   "same": "${LUMINA_FIXTURE_ROOT}/lr-sidecar-both/DSC08186.upper.XMP"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASE/shoot",
   "glob": "*",
   "count": 3
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTCASED/lr-folder",
   "glob": "*lumina-tmp*",
   "count": 0
  }
 ]
}
