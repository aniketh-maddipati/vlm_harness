{
 "mode": "app",
 "page": "Lumina Sets v5.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "budgets": {
  "webPeakMB": 1500
 },
 "stopOnFailure": true,
 "checklist": "Gate 5 (v5): a seeded key/mouse storm over a card read natively, with the card pulled and re-inserted at random (mid-read, mid-cull, on Save); the page's state surface and the Mac's reader are checked every 20 inputs. Afterwards the card is in, ⌘1 ⏎ reads all 80 with none unreadable, and nothing was ever written to the card.",
 "steps": [
  {
   "do": "startCards"
  },
  {
   "do": "diskImage",
   "name": "LTFUZZ",
   "sizeMB": 200,
   "from": "${LUMINA_FIXTURE_ROOT}/src",
   "trimBytes": 1400000,
   "count": 80
  },
  {
   "do": "waitFor",
   "js": "return !!(window.lumina.card && window.lumina.card.photos===80)",
   "timeoutMs": 10000,
   "what": "card noticed"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 50
  },
  {
   "do": "fuzz",
   "seed": 7,
   "count": 2000,
   "gapMs": [
    0,
    20
   ],
   "checkEvery": 20,
   "mouseRate": 0.05,
   "chaos": {
    "disk": "LTFUZZ",
    "rate": 0.006
   }
  },
  {
   "do": "attach",
   "name": "LTFUZZ",
   "ifPulled": true
  },
  {
   "do": "waitFor",
   "js": "return !!window.lumina.card && !window.__lumina.inspect().reading",
   "timeoutMs": 30000,
   "what": "card in, no read running"
  },
  {
   "do": "key",
   "k": "Escape",
   "settleMs": 150
  },
  {
   "do": "key",
   "k": "Escape",
   "settleMs": 150
  },
  {
   "do": "key",
   "k": "1",
   "settleMs": 400,
   "cmd": true
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.view",
   "equals": "import"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 100
  },
  {
   "do": "waitFor",
   "js": "const i=window.__lumina.inspect(); return !i.reading && i.real===80 && !i.realLoad && !!i.realInfo",
   "timeoutMs": 60000,
   "what": "full read after the storm"
  },
  {
   "do": "invariants"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.realInfo.bad",
   "equals": 0
  },
  {
   "do": "js",
   "src": "return JSON.stringify(await window.__lumina.nativeStats())"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTFUZZ",
   "glob": "*.xmp",
   "count": 0,
   "why": "no sidecar on the card, whatever the storm pressed"
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTFUZZ",
   "glob": "*lumina-*",
   "count": 0
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTFUZZ",
   "glob": "*.ARW",
   "count": 80
  },
  {
   "do": "snap",
   "name": "end"
  },
  {
   "do": "state",
   "name": "end"
  }
 ]
}
