{
 "mode": "app",
 "page": "Lumina Sets v5.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "stopOnFailure": true,
 "checklist": "F7 read-only / locked card \u2192 reads fine, never tries to write (card refused as destination)",
 "steps": [
  {
   "do": "startCards"
  },
  {
   "do": "diskImage",
   "name": "LTLOCKED",
   "sizeMB": 64,
   "from": "${LUMINA_FIXTURE_ROOT}/src",
   "trimBytes": 1400000,
   "count": 12,
   "readonly": true
  },
  {
   "do": "waitFor",
   "js": "return !!window.lumina.card",
   "timeoutMs": 15000,
   "what": "locked card noticed"
  },
  {
   "do": "key",
   "k": "0",
   "settleMs": 300
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 100
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad)",
   "timeoutMs": 60000,
   "what": "locked card read"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.realInfo.n",
   "equals": 12
  },
  {
   "do": "key",
   "k": "1",
   "settleMs": 300
  },
  {
   "do": "key",
   "k": "ArrowRight",
   "settleMs": 100
  },
  {
   "do": "key",
   "k": "ArrowRight",
   "settleMs": 100
  },
  {
   "do": "key",
   "k": "r",
   "settleMs": 100
  },
  {
   "do": "key",
   "k": "3",
   "settleMs": 400
  },
  {
   "do": "destinations",
   "paths": [
    "${DISKS}/LTLOCKED/DCIM",
    "${OUT}/xmp"
   ]
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 2500
  },
  {
   "do": "refusals",
   "count": 1
  },
  {
   "do": "fs",
   "path": "${OUT}/xmp",
   "glob": "*.xmp",
   "count": 1
  }
 ]
}