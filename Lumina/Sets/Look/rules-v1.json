    "sharpen": {
      "locked": false,
      "form": "unsharp mask with threshold in perceptual luma: hp = q - blur(q, radiusPx * px/refPx); q += sharpen*amountPerUnit*hp*smoothstep(threshold, 2*threshold, |hp|)",
      "coefficients": {
