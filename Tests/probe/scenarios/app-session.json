{
 "mode": "app",
 "app": {
  "sample": true
 },
 "page": "Lumina Sets v3.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "stopOnFailure": false,
 "steps": [
  {
