{
 "mode": "app",
 "page": "Lumina Sets v5.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "stopOnFailure": true,
 "checklist": "F7 read-only / locked card (v5): the card reads fine; Save on a card is replaced by 'copy to disk first' with the page's notice, ⌘↩ writes nothing to the card (no .xmp, no temp files).",
 "steps": [
  {
   "do": "startCards"
  },
  {
   "do": "diskImage",
   "name": "LTLOCKED",
   "sizeMB": 64,
   "from": "${LUMINA_FIXTURE_ROOT}/src",
   "trimBytes": 1400000,
   "count": 12,
   "readonly": true
  },
  {
   "do": "waitFor",
   "js": "return !!window.lumina.card",
   "timeoutMs": 15000,
   "what": "locked card noticed"
  },
  {
   "do": "key",
   "k": "0",
   "settleMs": 300
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 100
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad)",
   "timeoutMs": 60000,
   "what": "locked card read"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.realInfo.n",
   "equals": 12
  },
  {
   "do": "key",
   "k": "p",
   "settleMs": 200
  },
  {
   "do": "expect",
   "js": "return __probe.logic().kept().length",
   "equals": 1
  },
  {
   "do": "key",
   "k": "3",
   "cmd": true,
   "settleMs": 1000
  },
  {
   "do": "expect",
   "js": "return document.body.innerText.includes(\"Sidecars can't be written to a card\")",
   "why": "on a card the page offers 'copy to disk first' instead of Save"
  },
  {
   "do": "key",
   "k": "Enter",
   "cmd": true,
   "settleMs": 1500
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTLOCKED/DCIM",
   "glob": "*.xmp",
   "count": 0
  },
  {
   "do": "fs",
   "path": "${DISKS}/LTLOCKED/DCIM",
   "glob": "*.lumina-tmp*",
   "count": 0
  },
  {
   "do": "invariants"
  }
 ]
}
