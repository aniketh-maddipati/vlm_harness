{
 "mode": "app",
 "page": "Lumina Sets v12.dc.html",
 "size": [1440, 900],
 "clock": "2026-09-08T14:30:00",
 "sampleMs": 100,
 "deadline": 150,
 "stopOnFailure": false,
 "checklist": "Short crop edges on the orientation fixture (5 ARWs): open, Edit as shot, crop apply, apply again, base cache, undo back to the original. Screenshots are the snaps.",
 "steps": [
  {"do": "openFolder", "path": "${LUMINA_FIXTURE_ROOT}/orientation", "via": "js", "timeoutMs": 60000},
  {"do": "waitFor", "js": "return (__probe.logic().real||[]).length>=5", "timeoutMs": 60000, "what": "five orientation photos read"},
  {"do": "snap", "name": "01-read"},
  {"do": "dump", "name": "orientations", "js": "return JSON.stringify((__probe.logic().real||[]).map(p=>({name:p.name,orient:p.orient,portrait:p.portrait,rot:p.rot})))"},
  {"do": "js", "src": "window.__E=()=>{const el=document.querySelector('[data-lumina=\"canvas\"]');if(!el)return null;const k=Object.keys(el).find(x=>x.startsWith('__reactFiber$'));for(let f=el[k];f;f=f.return){const sn=f.stateNode;if(sn&&sn.logic&&sn.logic.cropStart)return sn.logic;}return null;};return luminaStep('edit')"},
  {"do": "waitFor", "js": "return __probe.logic().state.view==='edit'&&!!__E()", "timeoutMs": 15000, "what": "Edit is up"},
  {"do": "js", "src": "const E=__E(); if(E.state.intro&&E.closeIntro) E.closeIntro(); return true"},
  {"do": "waitFor", "js": "return !document.querySelector('[role=\"dialog\"]')", "timeoutMs": 4000, "what": "intro card gone"},
  {"do": "waitFor", "js": "return lumina.edit.stats().then(s=>s.path==='image'||s.renders>0)", "timeoutMs": 45000, "what": "canvas drew"},
  {"do": "wait", "ms": 800},
  {"do": "snap", "name": "02-edit-original"},
  {"do": "dump", "name": "before", "js": "const E=__E(),p=E.p(),L=E.look(p);return JSON.stringify({file:p&&p.file,orient:p&&p.orient,portrait:p&&p.portrait,crop:L.crop||null,rot:L.rot||0})"},
  {"do": "js", "src": "const E=__E();E.cropStart();E.straighten(6);return true"},
  {"do": "wait", "ms": 700},
  {"do": "snap", "name": "03-crop-draft"},
  {"do": "js", "src": "__E().cropApply();return true"},
  {"do": "wait", "ms": 900},
  {"do": "snap", "name": "04-crop-saved"},
  {"do": "dump", "name": "saved", "js": "const E=__E(),p=E.p(),L=E.look(p);return JSON.stringify({crop:L.crop||null,rot:L.rot||0})"},
  {"do": "js", "src": "const E=__E();E.cropStart();E.cropApply();return true"},
  {"do": "wait", "ms": 700},
  {"do": "snap", "name": "05-crop-resaved"},
  {"do": "dump", "name": "resaved", "js": "const E=__E(),p=E.p(),L=E.look(p);return JSON.stringify({crop:L.crop||null,rot:L.rot||0})"},
  {"do": "dump", "name": "cache", "js": "return lumina.edit.stats().then(s=>JSON.stringify({path:s.path,renders:s.renders,resident:s.bases&&s.bases.resident,photos:s.bases&&s.bases.residentPhotos,bytes:s.bases&&s.bases.bytes,errors:s.renderErrors}))"},
  {"do": "js", "src": "const E=__E(); E.undo(); E.undo(); return true"},
  {"do": "wait", "ms": 800},
  {"do": "snap", "name": "06-restored"},
  {"do": "dump", "name": "restored", "js": "const E=__E(),p=E.p(),L=E.look(p);return JSON.stringify({file:p&&p.file,crop:L.crop||null,rot:L.rot||0})"},
  {"do": "js", "src": "const p=(__probe.logic().real||[]).find(x=>x.portrait); if(!p) return false; __E().goId(p.id); return p.file||p.name"},
  {"do": "wait", "ms": 1200},
  {"do": "snap", "name": "07-portrait"},
  {"do": "dump", "name": "portrait", "js": "try{const E=__E(); if(!E||!E.p) return JSON.stringify({gone:true}); const p=E.p(); if(!p) return JSON.stringify({gone:true,view:__probe.logic().state.view}); return JSON.stringify({file:p.file,portrait:!!p.portrait});}catch(e){return String(e)}"}
 ]
}
