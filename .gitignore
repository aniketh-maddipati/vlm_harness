# Lumina
.DS_Store
.exiftool/
DerivedData/

# Harness / develop evidence — keep JSON/PNG/XMP reports;
# never commit full-res ProPhoto TIFFs or private RAW fixtures.
artifacts/**/handoff/*.tif
artifacts/**/handoff/*.tiff
artifacts/**/handoff/*.ARW
artifacts/**/handoff/*.arw

# Xcode
xcuserdata/
*.xcuserstate
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
.build/
Carthage/Build/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# UI-automation run outputs (xcresults, logs, isolated state)
artifacts/ui-automation/
*.profraw

# P0 edit harness run evidence — regenerate with `--p0-edit-harness` / `--p0-edit-live`
# (see docs/P0_EDITING.md). Frames run to tens of MB each and no test consumes them as a
# reviewed golden, so measurements live in the docs as tables instead.
artifacts/p0-edit/
artifacts/p0-edit-live/
