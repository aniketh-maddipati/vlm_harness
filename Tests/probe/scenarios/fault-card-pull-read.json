{
 "mode": "app",
 "page": "Lumina Sets v5.dc.html",
 "size": [
  1440,
  900
 ],
 "clock": "2026-09-08T14:30:00",
 "stopOnFailure": true,
 "checklist": "F2 card pulled mid-read → readers stop at once (nothing opened after), the page keeps and says what it read, previews of read photos still show; re-insert revives them and ⏎ reads all 200",
 "steps": [
  {
   "do": "startCards"
  },
  {
   "do": "diskImage",
   "name": "LTCARD",
   "sizeMB": 400,
   "from": "${LUMINA_FIXTURE_ROOT}/src",
   "trimBytes": 1400000,
   "count": 200
  },
  {
   "do": "waitFor",
   "js": "return !!(window.lumina.card && window.lumina.card.photos===200)",
   "timeoutMs": 10000,
   "what": "card noticed"
  },
  {
   "do": "key",
   "k": "0",
   "settleMs": 300
  },
  {
   "do": "snap",
   "name": "card-in"
  },
  {
   "do": "detach",
   "name": "LTCARD",
   "afterMs": 250
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 100
  },
  {
   "do": "waitFor",
   "js": "return window.lumina.card===null",
   "timeoutMs": 10000,
   "what": "card removal noticed"
  },
  {
   "do": "waitFor",
   "js": "return !__probe.logic().state.realLoad",
   "timeoutMs": 60000,
   "what": "read settles after the pull"
  },
  {
   "do": "expect",
   "js": "return /Card removed/.test(__probe.logic().state.toast||'')"
  },
  {
   "do": "js",
   "src": "return JSON.stringify(__probe.logic().state.realInfo)+' toast='+__probe.logic().state.toast"
  },
  {
   "do": "logged",
   "kind": "bridge",
   "match": "stopped reading DCIM"
  },
  {
   "do": "expect",
   "js": "const r=window.lumina.read; return r && r.stopped==='card removed' && r.total===200 && r.read===__probe.logic().state.realInfo.n && r.read+r.unreadable===200"
  },
  {
   "do": "expect",
   "js": "const s=await window.__lumina.nativeStats(); return s.gone.includes('DCIM') && s.opensAfterGone===0 && s.inFlight===0"
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(); return (await fetch(l.data.byId[l.state.cur].lg)).status",
   "equals": 200
  },
  {
   "do": "snap",
   "name": "card-pulled"
  },
  {
   "do": "key",
   "k": "1",
   "settleMs": 300
  },
  {
   "do": "key",
   "k": "ArrowDown",
   "settleMs": 100
  },
  {
   "do": "key",
   "k": "r",
   "settleMs": 100
  },
  {
   "do": "key",
   "k": "0",
   "settleMs": 300
  },
  {
   "do": "attach",
   "name": "LTCARD"
  },
  {
   "do": "waitFor",
   "js": "return !!window.lumina.card",
   "timeoutMs": 10000,
   "what": "card back"
  },
  {
   "do": "expect",
   "js": "const s=await window.__lumina.nativeStats(); return s.gone",
   "equals": []
  },
  {
   "do": "expect",
   "js": "const l=__probe.logic(), ids=l.data.order; let ok=0; for (const id of ids) ok += (await fetch(l.data.byId[id].lg)).status===200; return ok===ids.length"
  },
  {
   "do": "key",
   "k": "Enter",
   "settleMs": 100
  },
  {
   "do": "waitFor",
   "js": "const l=__probe.logic(); return !!(l.real && !l.state.realLoad) && l.real.length===200",
   "timeoutMs": 60000,
   "what": "full read after re-insert"
  },
  {
   "do": "expect",
   "js": "return __probe.logic().state.realInfo.bad",
   "equals": 0
  },
  {
   "do": "snap",
   "name": "card-back"
  }
 ]
}
