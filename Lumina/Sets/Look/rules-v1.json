        "landscapeGR": -0.09026,
        "landscapeGB": -0.20679,
        "landscapeBR": -0.08719,
        "landscapeBG": -0.23796,
        "landscapeHiDesat": 0.0,
        "landscapeLoDesat": 0.37748,
        "lightLift": -0.00762,
